  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.11",
    "discord.js": "^14.27.0",
    "mysql2": "^3.24.5",
    "shoukaku": "^4.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "typescript": "^7.0.2"
  }
}
