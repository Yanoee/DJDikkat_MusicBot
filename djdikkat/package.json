{
  "name": "djdikkat",
  "version": "6.0.0",
  "description": "Free Discord music bot with a web panel, welcome cards and moderation",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "start": "node --env-file-if-exists=../shared/.env src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts"
  },
  "keywords": [
    "discord",
    "discord-bot",
